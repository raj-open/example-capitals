# ----------------------------------------------------------------
# PROJECT SETTINGS
# ----------------------------------------------------------------

DOCKER_PROJECT="examplecapitals"

# ----------------------------------------------------------------
# BUILD
# ----------------------------------------------------------------

# archiver for C code in Rust crates; unset = `ar` from the PATH
PATH_AR="/usr/bin/ar"

# ----------------------------------------------------------------
# API
# ----------------------------------------------------------------

PORT=3001

# most detailed level of the log: error, warn, info, debug, trace or off
LOG_LEVEL="info"

# log the bodies of requests too (shortened); false where they may contain personal data
LOG_BODIES=true

# ----------------------------------------------------------------
# DB
# ----------------------------------------------------------------

DATABASE_HOST="localhost"
DATABASE_PORT=27017
DATABASE_NAME="capitals"
DATABASE_USER="root"
DATABASE_PASSWORD='*****'

# ----------------------------------------------------------------
# API CREDENTIALS
# ----------------------------------------------------------------

# buttons in the UI to clear and fill the DB (for tests); false where data must be kept
DATA_ACTIONS=true

RESTCOUNTRIES_URL="https://api.restcountries.com/countries/v5"
RESTCOUNTRIES_API_KEY='*****'
RESTCOUNTRIES_LIMIT=100
RESTCOUNTRIES_POPULATION_MIN=0
RESTCOUNTRIES_TOP=
VITE_MAPBOX_TOKEN='*****'
